 "quotes": [
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "Podium block … not of special architectural or historic interest",
   "pages": []
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "Covered market. 1835 by John Dobson for Richard Grainger. Painted plaster with cast iron grilles; cast iron girder roof to west range, plaster to other ranges.",
   "pages": [
    1024866
   ]
  },
  {
   "doc": "D063-reference-recheck-2026-10-14.md",
   "quote": "Sandstone ashlar; Welsh slate roof. 4 storeys, 46 bays in all; symmetrical.",
   "pages": [
    1355243
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "Top cornice, with parapet and pilasters, some with acroteria, to central and end groups; with blocking course to intermediate bays.",
   "pages": [
    1355243
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "Simple, arched roof of timber and glass.",
   "pages": [
    1286182
   ]
  },
  {
   "doc": "D063-reference-recheck-2026-10-14.md",
   "quote": "They are of red brick, with roofs concealed behind high parapets.",
   "pages": [
    1079481
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "Curved ends with full-height glazing and clerestoreys set slightly behind very narrow fascia bands.",
   "pages": [
    1079481
   ]
  },
  {
   "doc": "D063-reference-recheck-2026-10-14.md",
   "quote": "To the first floor a strip of glazing with a strongly horizontal pattern of steel glazing bars.",
   "pages": [
    1079481
   ]
  },
  {
   "doc": "D063-reference-recheck-2026-10-14.md",
   "quote": "concrete roof slab",
   "pages": [
    1079481
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "Moderne style",
   "pages": []
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "Exuberant Baroque style with French Second Empire features, two lower storeys with large display windows, four storeys above, and attics at corners.",
   "pages": [
    1294346
   ]
  },
  {
   "doc": "D063-reference-recheck-2026-10-14.md",
   "quote": "Pinky-buff terracotta facings by Doultons. Flat roofs and mansard attics with copper sheeting of fish-scale pattern.",
   "pages": [
    1294346
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "…octagonal cupolas and elaborate pedimented dormers in the mansard attics, and balustraded parapets at eaves and crown levels.",
   "pages": [
    1294346
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "American commercial Beaux-Arts design on the theme of a giant colonnade … 21 bays wide",
   "pages": [
    1357436
   ]
  },
  {
   "doc": "D063-reference-recheck-2026-10-14.md",
   "quote": "an eight-storey slab block (45-59 Kingsway) to the east, and a 17-storey cylindrical tower (1 Kemble Street) to the west",
   "pages": [
    1421847
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "…clad in polished grey granite, with the aluminium-framed glazing and dark-coloured spandrel panels set flush with the surface.",
   "pages": [
    1421847
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "…big tapering pilotis of in-situ concrete.",
   "pages": [
    1421847
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "curtain wall",
   "pages": [
    1113172,
    1242617,
    1350342
   ]
  },
  {
   "doc": "D063-reference-recheck-2026-10-14.md",
   "quote": "Building heights range from single-storey to 13-storeys; all with flat roofs.",
   "pages": [
    1259806
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "Deep red Gripper's patent Nottingham bricks with Ancaster stone dressings and shafts of grey and red Peterhead granite; slated roofs renewed in 1994…",
   "pages": [
    1342037
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "monumental, picturesquely composed Gothic Revival building of 23 windows flanked by towers and a curved 10 window wing to the west.",
   "pages": [
    1342037
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "4 main storeys with 2 extra storeys in the roof lit by stacks of gabled dormers.",
   "pages": [
    1342037
   ]
  },
  {
   "doc": "art-backlog-commerce-references.md",
   "quote": "a 33-storey tower to the west; a 9-storey rectangular block to the east…",
   "pages": [
    1113172
   ]
