 "text": {
  "lerp": "const lerp=(a,b,t)=>a+(b-a)*t;",
  "mulberry": "function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;}}",
  "noise": "function makeNoise(rand,G){\n  const v=new Float32Array(G*G);\n  for(let i=0;i<G*G;i++)v[i]=rand();\n  const at=(x,y)=>{\n    const xi=Math.floor(x),yi=Math.floor(y);\n    const xf=x-xi,yf=y-yi,sx=xf*xf*(3-2*xf),sy=yf*yf*(3-2*yf);\n    const g=(a,b)=>v[((a%G)+G)%G*G+(((b%G)+G)%G)];\n    return lerp(lerp(g(xi,yi),g(xi+1,yi),sx),lerp(g(xi,yi+1),g(xi+1,yi+1),sx),sy);\n  };\n  return (x,y)=>.6*at(x,y)+.3*at(x*2.13+7,y*2.13+3)+.1*at(x*4.7+13,y*4.7+11);\n}",
  "gen": "function genResource(sd){\n  const noiOil=makeNoise(mulberry32(sd^0x7c2f19),64), noiOre=makeNoise(mulberry32(sd^0x1a4d63),64); // 獨立種子噪聲，不消耗全域 R()\n  for(let y=0;y<N;y++)for(let x=0;x<N;x++){\n    const i=idx(x,y),t=tiles[i].t;\n    let r=0;\n    if(t===1||t===2){ // 僅陸地（沙/草）鋪資源，避開水域（呼應建築須陸地放置的通用限制）\n      if(noiOil(x*.045,y*.045)>.74)r=1;        // 油：低頻噪聲門檻→地理集中斑塊（非均勻）\n      else if(noiOre(x*.05+50,y*.05+50)>.74)r=2; // 礦：獨立噪聲場＋offset，避免與油田系統性重疊\n    }\n    RESOURCE[i]=r;\n  }\n}",
  "stock": "const RESOURCE_STOCK=240;               // T140：單一資源格總可開採量上限（RDEP 累計達此值即該格停產）",
  "rates": "const OIL_RATE=3,ORE_RATE=2;            // T140：油井/礦場每日抽取速率（供應品/天，直接疊加 supplies 與 RDEP，不消耗 R()）",
  "extract": "    if(b&&b.k===49){                   // T140：油井——每日抽取本格資源，累加 supplies，資源耗盡（RDEP 達上限）自動停產，不消耗 R()\n      owN++;\n      const oi=idx(x,y);\n      if(RESOURCE[oi]===1&&RDEP[oi]<RESOURCE_STOCK){\n        const ext=Math.min(OIL_RATE,RESOURCE_STOCK-RDEP[oi]);\n        RDEP[oi]+=ext;suppliesGain+=ext;oilGain+=ext;\n      }\n    }\n    if(b&&b.k===50){                   // T140：礦場——同油井樣式，不消耗 R()\n      mnN++;\n      const mi=idx(x,y);\n      if(RESOURCE[mi]===2&&RDEP[mi]<RESOURCE_STOCK){\n        const ext=Math.min(ORE_RATE,RESOURCE_STOCK-RDEP[mi]);\n        RDEP[mi]+=ext;suppliesGain+=ext;oreGain+=ext;\n      }\n    }",
  "restore": "    RDEP.fill(0); // T140：資源耗損先歸零，再視存檔內容還原（鐵律7）\n    if(Array.isArray(d.rdep))for(const pair of d.rdep){ // T140：稀疏可選欄位還原，舊檔缺 rdep 視為全數未耗損\n      if(!Array.isArray(pair)||pair.length<2)continue;\n      const ri140=pair[0]|0,amt=pair[1]|0;\n      if(ri140>=0&&ri140<N*N&&amt>0)RDEP[ri140]=Math.min(amt,RESOURCE_STOCK);\n    }",
  "pair": "\t      if(RDEP[i])rdepArr.push([i,RDEP[i]]); // T140：資源耗損（僅非零格才收錄，稀疏）",
  "field": "      rdep:rdepArr.length?rdepArr:null}; // T140：資源耗損（稀疏可選欄位，僅存已開採格；缺欄位＝未耗損。RESOURCE 本身不存，由 seed 經 genResource() 重建）",
  "callLoad": "    genResource(seed); // T140：資源層不入存檔，讀檔後以存檔內 seed 重建（tiles[].t 已於上方迴圈填妥）",
  "callNew": "  genResource(sd); // T140：資源層（獨立種子噪聲，不消耗全域 R()，見 genResource 定義處說明）",
  "canOil": "      if(toolId==='oilwell'&&RESOURCE[idx(x,y)]!==1)return '需油田資源格'; // T140：僅能放在油田資源格（GV.resourceAt 可查）",
  "canMine": "      if(toolId==='mine'&&RESOURCE[idx(x,y)]!==2)return '需礦藏資源格'; // T140：僅能放在礦藏資源格",
  "fuelMade": "  fuelMade=refineryN>0?Math.min(oilGain,refineryN*REFINERY_RATE*refineryUtil489,Math.max(0,fuelCap485-fuel)):0;",
  "steelMade": "  steelMade=steelMillN>0?Math.min(oreGain,steelMillN*STEEL_MILL_RATE*steelMillUtil489,Math.max(0,steelCap485-steel)):0;",
  "supplies": "  supplies+=suppliesGain-fuelMade-steelMade;"
 }
